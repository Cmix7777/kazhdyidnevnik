<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Скачанное обновление приложения отдаётся системному установщику -->
    <cache-path name="updates" path="updates/" />
    <!-- Снимок с камеры для переписки: камера пишет сюда, потом фото сжимается и уходит -->
    <cache-path name="camera" path="camera/" />
    <!-- Файл из переписки отдаётся приложению, которое умеет его открыть -->
    <cache-path name="shared" path="shared/" />
</paths>
