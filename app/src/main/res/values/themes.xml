<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Приложение всегда тёмное, фон окна совпадает с фоном экранов, чтобы не было белой вспышки -->
    <style name="Theme.Kazhdyidnevnik" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:colorBackground">@color/window_background</item>
    </style>
    <!-- Переписка: прозрачное окно, чтобы она открывалась каплей поверх дневника и схлопывалась обратно -->
    <style name="Theme.Kazhdyidnevnik.Chat" parent="Theme.Kazhdyidnevnik">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
